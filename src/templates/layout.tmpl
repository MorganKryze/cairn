{{define "top"}}<!doctype html>
<html lang="{{.Locale}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.PageTitle}}</title>
{{if .MetaDesc}}<meta name="description" content="{{.MetaDesc}}">
{{end}}<meta property="og:type" content="website">
<meta property="og:title" content="{{.PageTitle}}">
{{if .MetaDesc}}<meta property="og:description" content="{{.MetaDesc}}">
{{end}}<meta property="og:locale" content="{{.Locale}}">
<link rel="icon" href="/static/favicon.svg" type="image/svg+xml">
<link rel="preload" href="/static/fonts/fraunces.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/static/style.css">
<style>:root{--accent:{{.Accent}}}</style>
<script>if(document.cookie.split('; ').includes('about=off'))document.documentElement.setAttribute('data-noabout','');try{var t=localStorage.getItem('theme');if(t)document.documentElement.setAttribute('data-theme',t)}catch(e){}</script>
{{if .CustomCSS}}<link rel="stylesheet" href="/custom.css">
{{end}}</head>
<body>
<a class="skip" href="#main">{{.S.Skip}}</a>
<header><div class="wrap topbar">
  <a class="brand" href="/{{.Locale}}/">{{if .Logo}}<img src="{{.Logo}}" alt="">{{end}}{{.SiteTitle}}</a>
  <div class="topbar-tools">
    <button class="theme-toggle" id="theme-toggle" hidden aria-label="{{.S.Theme}}">
      <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
      <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2m7.07-17.07-1.41 1.41M6.34 17.66l-1.41 1.41M22 12h-2M4 12H2m17.07 7.07-1.41-1.41M6.34 6.34 4.93 4.93"/></svg>
    </button>
    <nav class="langs" aria-label="{{.S.Languages}}">{{$v := .}}{{range .Locales}}
      <a href="/{{.}}/{{$v.SwitchPath}}?choose"{{if eq . $v.Locale}} aria-current="page"{{end}}>{{upper .}}</a>{{end}}
    </nav>
  </div>
</div>
<div class="wrap menu"{{if .Links}} role="navigation" aria-label="{{.S.LinksLabel}}"{{end}}>
  {{range .Links}}<a class="menu-link" href="{{.URL}}">{{if .IconSVG}}{{.IconSVG}}{{else if .IconIMG}}<img src="{{.IconIMG}}" alt="">{{end}}{{.Label}}</a>
  {{end}}{{if .Search}}<div class="search" id="search">
    <div class="search-box">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.8-3.8"/></svg>
      <label class="visually-hidden" for="q">{{.S.SearchLabel}}</label>
      <input id="q" type="search" placeholder="{{.S.SearchPlaceholder}}" autocomplete="off" disabled>
      <kbd class="search-kbd" hidden>⌘K</kbd>
    </div>
  </div>
  {{else}}<div class="search" aria-hidden="true">
    <div class="search-box">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.8-3.8"/></svg>
      <input type="search" placeholder="{{.S.SearchPlaceholder}}" disabled tabindex="-1">
    </div>
  </div>
  {{end}}</div>
</header>
<main id="main"><div class="wrap">
{{end}}

{{define "bottom"}}</div></main>
<footer><div class="wrap foot">
  <span class="foot-mark">{{template "glyph"}}</span>
  {{if .Footer}}<div class="foot-links">{{range .Footer}}<a href="{{.URL}}">{{.Label}}</a>{{end}}</div>
  {{end}}{{if .Credit}}<span class="powered">{{.S.Powered}} <a href="https://github.com/MorganKryze/cairn">cairn</a></span>
  {{end}}</div></footer>
<script src="/static/search.js" defer></script>
<script src="/static/toc.js" defer></script>
<script src="/static/about.js" defer></script>
<script src="/static/theme.js" defer></script>
</body>
</html>
{{end}}

{{define "glyph"}}<svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><rect x="5" y="24" width="22" height="4.6" rx="2.3"/><rect x="8.5" y="18.2" width="16.6" height="4.4" rx="2.2"/><rect x="8.8" y="12.6" width="14.4" height="4.2" rx="2.1"/><rect x="9.4" y="7.4" width="11" height="3.9" rx="1.95"/><rect x="12" y="2.6" width="8" height="3.6" rx="1.8"/></svg>{{end}}
