{{define "top"}}<!doctype html>
<html lang="{{.Locale}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.PageTitle}}</title>
{{if .MetaDesc}}<meta name="description" content="{{.MetaDesc}}">
{{end}}<meta property="og:type" content="website">
<meta property="og:title" content="{{.PageTitle}}">
{{if .MetaDesc}}<meta property="og:description" content="{{.MetaDesc}}">
{{end}}<meta property="og:locale" content="{{.Locale}}">
<link rel="icon" href="/static/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/static/style.css">
<style>:root{--accent:{{.Accent}}}</style>
{{if .CustomCSS}}<link rel="stylesheet" href="/custom.css">
{{end}}</head>
<body>
<a class="skip" href="#main">{{.S.Skip}}</a>
<header>
  <div class="brand">{{if .Logo}}<img src="{{.Logo}}" alt="">{{end}}{{.SiteTitle}}</div>
  <nav aria-label="{{.S.Languages}}">{{$v := .}}{{range .Locales}}
    <a href="/{{.}}/{{$v.SwitchPath}}"{{if eq . $v.Locale}} aria-current="page"{{end}}>{{upper .}}</a>{{end}}
  </nav>
</header>
<main id="main">
{{end}}

{{define "bottom"}}</main>
{{if .Footer}}<footer><nav>{{range .Footer}}<a href="{{.URL}}">{{.Label}}</a>{{end}}</nav></footer>
{{end}}<script src="/static/search.js" defer></script>
</body>
</html>
{{end}}

{{define "glyph"}}<svg class="icon" viewBox="0 0 32 32" aria-hidden="true"><g fill="currentColor"><rect x="11" y="4" width="10" height="6" rx="3"/><rect x="8" y="12" width="16" height="7" rx="3.5"/><rect x="5" y="21" width="22" height="8" rx="4"/></g></svg>{{end}}
