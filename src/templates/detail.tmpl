{{template "top" .}}
<article class="detail">
  <p><a class="back" href="{{.Prefix}}/{{.Locale}}/">← {{.S.Back}}</a></p>
  <div class="detail-head">
    <span class="tile">{{if .Icon}}<img src="{{.Icon}}" alt="" width="56" height="56">{{else}}{{template "glyph"}}{{end}}</span>
    <div class="detail-title">
      <h1>{{.Name}}</h1>
      {{if .Status}}<a class="status-pill status-{{.Status}}" href="{{.StatusHref}}" target="_blank" rel="noopener" aria-label="{{.Name}}, {{.StatusLabel}}, {{.S.Link}}"><span class="dot" aria-hidden="true"></span>{{.StatusLabel}}</a>{{end}}
    </div>
  </div>
  {{if .Desc}}<p class="lead">{{.Desc}}</p>
  {{end}}{{range .Body}}{{.}}
  {{end}}{{range .Images}}<figure class="shot"><img src="{{.Src}}" alt="" loading="lazy"{{if .W}} width="{{.W}}" height="{{.H}}"{{end}}>{{if .Caption}}<figcaption>{{.Caption}}</figcaption>{{end}}</figure>
  {{end}}<p><a class="btn" href="{{.URL}}">{{.S.Open}}</a></p>
</article>
{{template "bottom" .}}
