{{define "top"}}<!doctype html>
<html lang="{{.Locale}}" dir="{{.Dir}}"{{if .Prefix}} data-base="{{.Prefix}}"{{end}}{{if .AboutHash}} data-about="{{.AboutHash}}"{{end}}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{{/* Here is where a fallback cannot be marked, and nothing below pretends
     otherwise. The meta descriptions are attribute values: text with no
     element of its own to hang lang and dir on. <title> has an element, but it
     is drawn in the browser chrome rather than in the page, and a detail
     page's title is two fields glued with a separator, so a single attribute
     could only ever be right about half of it. A title that fell back to
     another language says so nowhere, of necessity; the visible headings that
     repeat it lower down do carry the mark. */}}
<title>{{.PageTitle}}</title>
{{if .MetaDesc}}<meta name="description" content="{{.MetaDesc}}">
{{end}}<meta property="og:type" content="website">
<meta property="og:title" content="{{.PageTitle}}">
{{if .MetaDesc}}<meta property="og:description" content="{{.MetaDesc}}">
{{end}}<meta property="og:locale" content="{{.Locale}}">
{{if .OGImage}}<meta property="og:image" content="{{.OGImage}}">
{{end}}{{if .Noindex}}<meta name="robots" content="noindex">
{{end}}{{if .Base}}<link rel="canonical" href="{{.Base}}/{{.Locale}}/{{.SwitchPath}}">
<meta property="og:url" content="{{.Base}}/{{.Locale}}/{{.SwitchPath}}">
{{range .Locales}}<link rel="alternate" hreflang="{{.}}" href="{{$.Base}}/{{.}}/{{$.SwitchPath}}">
{{end}}<link rel="alternate" hreflang="x-default" href="{{.Base}}/">
{{end}}
{{if .Favicon}}{{if .FaviconDark}}<link rel="icon" href="{{.FaviconDark}}" media="(prefers-color-scheme: dark)">
{{end}}<link rel="icon" href="{{.Favicon}}">
{{else}}<link rel="icon" href="{{.Prefix}}/static/favicon.svg" type="image/svg+xml">
<link rel="icon" href="{{.Prefix}}/static/favicon.ico" sizes="32x32">
{{end}}<link rel="apple-touch-icon" href="{{.TouchIcon}}">
<link rel="manifest" href="{{.Prefix}}/manifest.webmanifest">

<link rel="preload" href="{{.Prefix}}/static/fonts/fraunces.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{.Prefix}}/static/style.css">
<style>{{.Style}}</style>
<script>document.documentElement.setAttribute('data-js','');var a=document.cookie.match(/(?:^|; )about=([^;]*)/);if(a&&a[1]===document.documentElement.getAttribute('data-about'))document.documentElement.setAttribute('data-noabout','');try{var t=localStorage.getItem('theme');if(t)document.documentElement.setAttribute('data-theme',t)}catch(e){}</script>
{{if .CustomCSS}}<link rel="stylesheet" href="{{.Prefix}}/custom.css">
{{end}}</head>
<body>
<a class="skip" href="#main">{{.S.Skip}}</a>
<header><div class="wrap topbar">
  <a class="brand" href="{{.Prefix}}/{{.Locale}}/"{{.SiteTitle.Attrs}}>{{if .Logo}}<img src="{{.Logo}}" alt="">{{end}}{{.SiteTitle}}</a>
  <div class="topbar-tools">
    <button class="theme-toggle" id="theme-toggle" hidden aria-label="{{.S.Theme}}">
      <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
      <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2m7.07-17.07-1.41 1.41M6.34 17.66l-1.41 1.41M22 12h-2M4 12H2m17.07 7.07-1.41-1.41M6.34 6.34 4.93 4.93"/></svg>
    </button>
    {{$v := .}}{{if gt (len .Locales) 3}}<details class="langs langs-menu">
      <summary aria-label="{{.S.Languages}}">{{upper .Locale}}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
      <nav aria-label="{{.S.Languages}}">{{range .Locales}}
        <a href="{{$v.Prefix}}/{{.}}/{{$v.SwitchPath}}?choose"{{if eq . $v.Locale}} aria-current="page"{{end}}>{{upper .}}</a>{{end}}
      </nav>
    </details>
    {{else}}<nav class="langs" aria-label="{{.S.Languages}}">{{range .Locales}}
      <a href="{{$v.Prefix}}/{{.}}/{{$v.SwitchPath}}?choose"{{if eq . $v.Locale}} aria-current="page"{{end}}>{{upper .}}</a>{{end}}
    </nav>{{end}}
  </div>
</div>
<div class="wrap menu">
  {{if .Links}}<details class="nav">
    <summary class="nav-burger" aria-label="{{.S.LinksLabel}}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg><span>{{.S.Menu}}</span></summary>
    <nav class="nav-links" aria-label="{{.S.LinksLabel}}">{{range .Links}}<a class="menu-link" href="{{.URL}}"{{.Label.Attrs}}>{{if .IconSVG}}{{.IconSVG}}{{else if .IconIMG}}<img src="{{.IconIMG}}" alt="">{{end}}{{.Label}}</a>
    {{end}}</nav>
  </details>
  {{end}}{{if .Search}}<div class="search" id="search">
    <div class="search-box">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.8-3.8"/></svg>
      <label class="visually-hidden" for="q">{{.S.SearchLabel}}</label>
      <input id="q" type="search" placeholder="{{.S.SearchPlaceholder}}" autocomplete="off" enterkeyhint="go" disabled>
      <kbd class="search-kbd" hidden>⌘K</kbd>
    </div>
  </div>
  {{else}}<div class="search" aria-hidden="true">
    <div class="search-box">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.8-3.8"/></svg>
      <input type="search" placeholder="{{.S.SearchPlaceholder}}" disabled tabindex="-1">
    </div>
  </div>
  {{end}}</div>
</header>
<main id="main"><div class="wrap">
{{end}}

{{define "bottom"}}</div></main>
<footer><div class="wrap foot">
  {{if .Footer}}<div class="foot-links">{{range .Footer}}<a href="{{.URL}}"{{.Label.Attrs}}>{{.Label}}</a>{{end}}</div>
  {{end}}{{if .Credit}}<span class="powered"><span class="foot-mark">{{template "glyph"}}</span>{{.S.Powered}} <a href="https://github.com/MorganKryze/cairn" title="cairn {{.Version}}">cairn</a>{{if .ShowVer}} {{if .VerHref}}<a class="foot-version" href="{{.VerHref}}">{{.VerLabel}}</a>{{else}}<span class="foot-version">{{.VerLabel}}</span>{{end}}{{end}}</span>
  {{end}}</div></footer>
<a class="totop" href="#top" aria-label="{{.S.Top}}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7"/></svg></a>
{{if .Leave}}<!-- A native <dialog>, so the focus trap, Escape and aria-modal
     come from the browser rather than from a script that has to remember all
     three. leave.js fills the two blanks and calls showModal(); with no
     script the guarded links are ordinary links and this never opens.

     The continue button is a real anchor rather than a scripted navigation:
     a window.open() after a dialog is what a popup blocker is for, and an
     href needs no permission from anybody. -->
<dialog id="leave" class="leave" aria-labelledby="leave-title">
  <h2 id="leave-title">{{.S.LeaveTitle}}</h2>
  <p class="leave-body">{{.S.LeaveBody}}</p>
  <p class="leave-url"><span class="leave-host"></span><span class="leave-rest"></span></p>
  <div class="leave-acts">
    <button type="button" class="leave-copy" data-done="{{.S.LeaveCopied}}">{{.S.LeaveCopy}}</button>
    <button type="button" class="leave-stay">{{.S.LeaveStay}}</button>
    <a class="btn leave-go" href=""{{if .LeaveBlank}} target="_blank" rel="noopener noreferrer"{{end}}>{{.S.LeaveGo}}</a>
  </div>
</dialog>
<script src="{{.Prefix}}/static/leave.js" defer></script>
{{end}}<script src="{{.Prefix}}/static/search.js" defer></script>
<script src="{{.Prefix}}/static/toc.js" defer></script>
<script src="{{.Prefix}}/static/nav.js" defer></script>
<script src="{{.Prefix}}/static/about.js" defer></script>
<script src="{{.Prefix}}/static/theme.js" defer></script>
{{if .StatusPoll}}<script src="{{.Prefix}}/static/status.js" defer data-poll="{{.StatusPoll}}"></script>
{{end}}</body>
</html>
{{end}}

{{/* The status pill, on a card and on a detail page alike. A link when it
     leads to a status page the visitor can reach, a plain span when the
     operator set status.linked: false, in which case it states the state and
     nothing else: no target, no focus stop, and on a card the click falls
     through to the service the way the rest of the card behaves.

     The slot around it is what status.js replaces. It exists on every service
     of a site that has a Gatus and is empty when there is no pill, because
     "no pill" is one of the states a refresh has to be able to arrive at. A
     site without a Gatus emits neither, exactly as before. */}}
{{define "statuspill"}}{{if .StatusID}}<span class="status-slot" data-status="{{.StatusID}}">{{if .Status}}{{if .StatusHref}}<a class="status-pill status-{{.Status}}" href="{{.StatusHref}}" target="_blank" rel="noopener" aria-label="{{.StatusA11y}}"><span class="dot" aria-hidden="true"></span>{{.StatusLabel}}</a>{{else}}<span class="status-pill status-{{.Status}}"><span class="dot" aria-hidden="true"></span>{{.StatusLabel}}</span>{{end}}{{end}}</span>{{end}}{{end}}

{{/* A long text field, already rendered to markdown blocks. The wrapper exists
     only to carry lang and dir, so it appears only when the text is not in the
     page's language: a site translated for the locales it lists emits exactly
     the markup it always did, and the div shows up on the pages that would
     otherwise lie about what language they are reading. */}}
{{define "prose"}}{{if .Attrs}}<div{{.Attrs}}>{{end}}{{range .Blocks}}{{.}}
{{end}}{{if .Attrs}}</div>
{{end}}{{end}}

{{define "glyph"}}<svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><rect x="3.2" y="23.6" width="25" height="5.4" rx="2.4"/><rect x="7.8" y="16.2" width="17.4" height="5.8" rx="2.6"/><rect x="9.4" y="9.4" width="13" height="5.4" rx="2.5"/><rect x="12.4" y="3" width="9.4" height="4.8" rx="2.2" transform="rotate(-9 17.1 5.4)"/></svg>{{end}}
