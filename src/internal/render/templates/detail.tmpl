{{template "top" .}}
<article class="detail">
  {{/* One grid for the whole head, because the action sits in two different
       places and CSS cannot move an element between parents: beside the name
       where there is room, and at the start of the line under it where there
       is not. Back, Open, then the pill is the order Tab walks either way.
       Naming the areas says both without a second copy of the markup.

       The state is a row of its own rather than a child of the name: inside
       one it made that block taller, and centring the tile against the taller
       box put the icon 18.4px below the name it belongs to. */}}<div class="detail-top">
    <a class="back" href="{{.Prefix}}/{{.Locale}}/"><svg class="back-glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>{{.S.Back}}</a>
    <span class="tile">{{if .Icon}}<img{{if .IconClass}} class="{{.IconClass}}"{{end}} src="{{.Icon}}" alt="" width="56" height="56">{{else}}{{template "glyph"}}{{end}}</span>
    <h1{{.Name.Attrs}}>{{.Name}}</h1>
    {{if not .Off}}<a class="btn" href="{{.URL}}"{{if .Blank}} target="_blank" rel="noopener noreferrer"{{end}}{{if .Leave}} data-leave{{end}}>{{.S.Open}}<svg class="btn-glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 5h5v5"/><path d="M19 5 11 13"/><path d="M17 14v4a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V8a1 1 0 0 1 1-1h4"/></svg></a>{{end}}
    {{if or .State .StatusID}}<div class="detail-state-row">{{template "statuspill" .}}{{if .State}}<span class="detail-state detail-state-{{.State}}">{{.StateLabel}}</span>{{end}}</div>{{end}}
  </div>
  {{if .SignIn}}<div class="signin" role="note"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg><p><strong>{{.SignInLabel}}</strong>{{.SignInNote}}</p></div>
  {{end}}{{if .Desc.Text}}<p class="lead"{{.Desc.Attrs}}>{{.Desc}}</p>
  {{end}}{{template "prose" .Body}}{{/* On a phone a wide screenshot scrolls
       sideways at a readable height. The strip sizes the image from the ratio
       its width and height attributes give it, and a contained image with no
       ratio collapses to nothing, so the strip is only drawn where cairn read
       both. Each strip is a landmark and a screen reader lists landmarks by
       name, so the name carries the image's place on the page and the caption
       describes it. The markup gives it no tabindex: toc.js makes it a stop
       only while it scrolls, which WebKit does not do on its own. The link
       opens the file itself in the same tab, the one way to the whole picture
       on a phone. */}}{{range .Images}}<figure class="shot">{{if and .W .H}}<div class="shot-scroll" role="region" aria-label="{{$.S.ShotScroll}} {{.N}}"{{if .Caption.Text}} aria-describedby="shot-{{.N}}-caption"{{end}}>{{end}}<img src="{{.Src}}" alt="" loading="lazy"{{if .W}} width="{{.W}}" height="{{.H}}"{{end}}>{{if and .W .H}}</div>{{end}}{{if .Caption.Text}}<figcaption{{if and .W .H}} id="shot-{{.N}}-caption"{{end}}{{.Caption.Attrs}}>{{.Caption}}</figcaption>{{end}}<a class="shot-full" href="{{.Src}}"><svg class="shot-full-glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6"/><path d="M9 21H3v-6"/><path d="m21 3-7 7"/><path d="m3 21 7-7"/></svg>{{$.S.ShotFull}}</a></figure>
  {{end}}</article>
{{template "bottom" .}}
