{{template "top" .}}
<article class="detail page">
  <p><a class="back" href="{{.Prefix}}/{{.Locale}}/">{{.S.Back}}</a></p>
  <header class="page-head">
    <span class="way-mark" aria-hidden="true"></span>
    <h1{{.Title.Attrs}}>{{.Title}}</h1>
    <span class="way-rule" aria-hidden="true"></span>
  </header>
  {{template "prose" .Intro}}{{range .Sections}}<section class="page-sec">
    <h2{{.Title.Attrs}}>{{.Title}}</h2>
    {{template "prose" .Body}}</section>
  {{end}}</article>
{{template "bottom" .}}
