{{template "top" .}}
<h1 class="visually-hidden"{{.SiteTitle.Attrs}}>{{.SiteTitle}}</h1>
{{if .Tagline.Text}}<p class="tagline"{{.Tagline.Attrs}}>{{.Tagline}}</p>
{{end}}{{if .About.Blocks}}<section class="about">
  {{/* The dismiss button is a cairn string, always in the page's language, so
       the note's own marking goes on the note and not on the section: putting
       it here would have claimed the button reads in another language too. */}}
  <button class="about-x" id="about-x" hidden><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg><span>{{.S.Dismiss}}</span></button>
  {{template "prose" .About}}</section>
{{end}}{{if gt (len .Cats) 1}}<nav class="toc" aria-label="{{.S.Toc}}">
  <ul>
    {{range .Cats}}<li><a href="#cat-{{.ID}}"><span class="toc-mark" aria-hidden="true"></span><span class="toc-name"{{.Name.Attrs}}>{{.Name}}</span></a></li>
    {{end}}
  </ul>
</nav>
{{end}}{{range .Cats}}<section class="cat" aria-labelledby="cat-{{.ID}}">
  <div class="way">
    <span class="way-mark" aria-hidden="true"></span>
    <h2 id="cat-{{.ID}}" class="way-name"{{.Name.Attrs}}><a href="#cat-{{.ID}}"><svg class="way-link" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07l-1.5 1.5"/><path d="M14 11a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07l1.5-1.5"/></svg>{{.Name}}</a></h2>
    <span class="way-rule" aria-hidden="true"></span>
  </div>
  <ul class="cards">
    {{/* The badge is the card's first child so it is read before the name,
         which is the right order for a service that is gone. It hangs on the
         top border rather than taking a row: the grid stretches a row to its
         tallest card, so a row inside would charge its height to every card
         beside it. The comment closes hard against the range, since the
         newline after it would otherwise print into every page that has no
         state at all. */}}{{range .Cards}}<li class="card{{if .Off}} card-off{{end}}"{{if .Tags}} data-tags="{{.Tags}}"{{end}}>
      {{if .State}}<span class="card-badge card-badge-{{.State}}">{{.StateLabel}}</span>
      {{end}}<div class="card-main">
        <span class="tile">{{if .Icon}}<img{{if .IconClass}} class="{{.IconClass}}"{{end}} src="{{.Icon}}" alt="" loading="lazy" width="40" height="40">{{else}}{{template "glyph"}}{{end}}</span>
        <div class="card-text">
          {{if .Off}}<span class="card-name"{{.Name.Attrs}}>{{.Name}}</span>{{else}}<a class="card-name" href="{{.URL}}"{{if .Blank}} target="_blank" rel="noopener noreferrer"{{end}}{{if .Leave}} data-leave{{end}}{{.Name.Attrs}}>{{.Name}}</a>{{end}}
          {{if .Desc.Text}}<span class="card-desc"{{.Desc.Attrs}}>{{.Desc}}</span>{{end}}
        </div>
      </div>
      {{/* The detail link is a glyph in the corner rather than words inside the
           description: it keeps the prose prose, and it gives the link a target
           a thumb can hit. The name it is read by is on the anchor, since a
           glyph carries none. */}}
      {{if .MoreHref}}<a class="card-more" href="{{.MoreHref}}" aria-label="{{.MoreA11y}}" title="{{$.S.More}}"><svg class="more-glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 10.8v5"/><path d="M12 7.4v.4"/></svg></a>{{end}}
      {{if or .HostKind .StatusID}}<div class="card-foot">{{if .HostKind}}{{if .HostHref}}<a class="flag flag-{{.HostKind}}" href="{{.HostHref}}"{{if .HostBlank}} target="_blank" rel="noopener noreferrer"{{end}}>{{else}}<span class="flag flag-{{.HostKind}}">{{end}}{{if eq .HostKind "self"}}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>{{else}}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.5 19H9a5 5 0 1 1 .5-9.98A6 6 0 0 1 21 9.5a4.5 4.5 0 0 1-3.5 9.5Z"/></svg>{{end}}<span class="flag-label">{{.HostLabel}}</span>{{if .HostHref}}</a>{{else}}</span>{{end}}{{end}}{{template "statuspill" .}}</div>
      {{end}}</li>
    {{end}}
  </ul>
</section>
{{end}}<p id="empty" class="empty" role="status" hidden>{{.S.SearchEmpty}}</p>
<p id="count" class="visually-hidden" role="status" aria-live="polite" data-single="{{.S.SearchOne}}" data-plural="{{.S.SearchMany}}"></p>
{{template "bottom" .}}
